*.png filter=lfs diff=lfs merge=lfs -text

# Blender scenes and every USD flavour we ship. These are binary (or, for
# .usda, large enough that a diff is noise), and the evaluation scenes are
# regenerated by scripts/build_test_scenes.py rather than hand-edited, so a
# full blob per regeneration would otherwise land in history.
*.blend filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
