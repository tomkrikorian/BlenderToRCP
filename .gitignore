# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Blender backups
*.blend1

# Export diagnostics
*.diagnostics.json

# macOS Finder metadata
.DS_Store

# Build artifacts
dist/

# Background bake/export jobs
.blendertorcp_jobs/

# Export publication transaction dirs (staging + per-output locks). Created
# next to the output whenever an export publishes, including into a tracked
# tree such as References/.
.blendertorcp_publish/
.blendertorcp_temp/
.blendertorcp_generations/

# Test output
tests/tmp/
.pytest_cache/

# RCP .import research fixtures: opaque buffer payloads stay local.
# See docs/RCP_IMPORT_EXPERIMENT.md — these are regenerated, never committed.
*.import/
