# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Blender backups
*.blend1

# Export diagnostics
*.diagnostics.json

# macOS Finder metadata
.DS_Store

# Build artifacts
dist/

# Background bake/export jobs
.blendertorcp_jobs/

# Export publication transaction dirs (staging + per-output locks). Created
# next to the output whenever an export publishes, including into a tracked
# tree such as References/.
.blendertorcp_publish/
.blendertorcp_temp/
.blendertorcp_generations/

# Test output
tests/tmp/
.pytest_cache/

# Reality Composer Pro builds an .import cache beside any asset it imports.
# It is the editor's own regenerated content, never ours to commit.
*.import/

# Evaluation-scene exports; regenerate with scripts/export_test_scenes.sh.
# The .blend sources in References/Blender are tracked; these are not.
References/RealityComposerProProject/Export/t*/

# Reality Composer Pro 3 project: the package holds .import packages only.
# Everything under its Export/ is RCP's own imported copy of an asset, which it
# rewrites on every import; the assets themselves live in
# References/RealityComposerProProject/Export/.
References/RealityComposerProProject/RealityComposerProProject.realitycomposerpro/Export/
References/RealityComposerProProject/RealityComposerProProject.realitycomposerpro/core.lib/
